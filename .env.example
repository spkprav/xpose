# ── Standalone scripts (scripts/*.mjs, scripts/render-hairball.py) ─────
# These run via `node` or `python3` outside Electron and read env vars.
# The Electron app reads NEON_DB_URL and the two Cursor webhook keys below.
# When NEON_DB_URL is set, the app writes there and ignores the Settings host.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=xpose

# ── Ollama (local LLM for wiki keyword/niche extraction) ──────────────
# Used by lib/wiki/extract-keywords.js and lib/wiki/classify-niche.js.
# Override host if running ollama on another machine or non-default port.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# App database. Direct or pooled Neon connection string.
NEON_DB_URL=

# After a live pass finishes, xpose POSTs once so the check can read
# the same Postgres the app writes to. There is no dump or restore.
# Copy both values from the routine panel. The token is the Authorization header.
CURSOR_AUTOMATION_WEBHOOK=
CURSOR_AUTOMATION_WEBHOOK_TOKEN=
