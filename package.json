{
  "name": "xpose",
  "version": "1.0.0",
  "description": "Electron desktop tool that crawls your X (Twitter) circle and turns it into a queryable Postgres + Obsidian wiki. No API keys. uses your logged-in browser session.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:create": "psql -h ${PGHOST:-localhost} -p ${PGPORT:-5432} -U ${PGUSER:-postgres} -d postgres -tc \"SELECT 1 FROM pg_database WHERE datname = '${PGDATABASE:-xpose}'\" | grep -q 1 || createdb -h ${PGHOST:-localhost} -p ${PGPORT:-5432} -U ${PGUSER:-postgres} ${PGDATABASE:-xpose}",
    "db:psql": "psql -h ${PGHOST:-localhost} -p ${PGPORT:-5432} -U ${PGUSER:-postgres} -d ${PGDATABASE:-xpose}",
    "db:migrate": "psql -v ON_ERROR_STOP=1 -h ${PGHOST:-localhost} -p ${PGPORT:-5432} -U ${PGUSER:-postgres} -d ${PGDATABASE:-xpose} -f schema.sql",
    "wiki:setup": "bash lib/wiki/setup-ollama.sh",
    "wiki:gen": "node lib/wiki/generate.js",
    "wiki:keywords": "node lib/wiki/extract-keywords.js",
    "wiki:flush": "node lib/wiki/flush-keywords.js",
    "wiki:enrich-rt": "node lib/wiki/enrich-from-rt.js",
    "wiki:bucket": "node lib/wiki/classify-niche.js",
    "wiki:lists": "node lib/wiki/lists.js"
  },
  "keywords": [
    "electron",
    "twitter",
    "x",
    "social-graph",
    "obsidian",
    "postgres"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.2",
    "nodemon": "^3.1.0",
    "playwright": "^1.43.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.6.1",
    "electron-fetch": "^1.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "fs": "^0.0.1-security",
    "lodash": "^4.17.21",
    "pg": "^8.17.2",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^22.7.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
